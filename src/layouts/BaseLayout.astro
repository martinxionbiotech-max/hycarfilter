---
// BaseLayout — shared shell (head, header, footer, lang/dir + hreflang)
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site } from '../data/site';
import { getLocaleFromPath, localeMeta, hreflangAlternates } from '../i18n';

interface Alternate {
  lang: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  /** Override <html lang> (defaults to the active locale). */
  lang?: string;
  /** Override <html dir> (defaults to the active locale). */
  dir?: 'ltr' | 'rtl';
  /** Page-level hreflang alternates; when omitted, auto-generated from the URL. */
  alternates?: Alternate[];
}

const { title, description, lang, dir, alternates } = Astro.props;

const currentLocale = getLocaleFromPath(Astro.url.pathname);
const locale = localeMeta[currentLocale];
const htmlLang = lang ?? locale.lang;
const htmlDir = dir ?? locale.dir;

const tagline =
  currentLocale === 'ar' ? site.taglineAr : currentLocale === 'es' ? site.taglineEs : site.tagline;

const fullTitle = `${title} | ${site.brand} — ${tagline}`;
const metaDescription =
  description ||
  (currentLocale === 'ar'
    ? `${site.brand} هو مُصنّع ومُصدّر احترافي لفلاتر السيارات (هواء، مقصورة، زيت، وقود، مسّاحات، مصافي ناقل الحركة ومصابيح LED).`
    : currentLocale === 'es'
      ? `${site.brand} es un fabricante y exportador profesional de filtros automotrices (aire, habitáculo, aceite, combustible, escobillas, mallas de transmisión y luces LED).`
      : `${site.brand} is a professional automotive filter manufacturer and exporter (air, cabin, oil, fuel filters, wipers, transmission screens, LED lights).`);

const siteUrl = Astro.site?.toString() ?? 'https://hycarfilter.com';
const canonical = new URL(Astro.url.pathname, Astro.site);
const finalAlternates = alternates ?? hreflangAlternates(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang={htmlLang} dir={htmlDir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <link rel="canonical" href={canonical} />
    {finalAlternates?.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
  </body>
</html>

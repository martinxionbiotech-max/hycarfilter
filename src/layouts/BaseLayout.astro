---
// BaseLayout — shared shell (head, header, footer, lang/dir + hreflang)
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site } from '../data/site';
import { getLocaleFromPath, localeMeta, hreflangAlternates } from '../i18n';

interface Alternate {
  lang: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  /** Override <html lang> (defaults to the active locale). */
  lang?: string;
  /** Override <html dir> (defaults to the active locale). */
  dir?: 'ltr' | 'rtl';
  /** Page-level hreflang alternates; when omitted, auto-generated from the URL. */
  alternates?: Alternate[];
  /** Suppress canonical + hreflang and mark the page noindex (404 pages). */
  noindex?: boolean;
}

const { title, description, lang, dir, alternates, noindex } = Astro.props;

const currentLocale = getLocaleFromPath(Astro.url.pathname);
const locale = localeMeta[currentLocale];
const htmlLang = lang ?? locale.lang;
const htmlDir = dir ?? locale.dir;

const tagline =
  currentLocale === 'ar' ? site.taglineAr : currentLocale === 'es' ? site.taglineEs : site.tagline;

const fullTitle = `${title} | ${site.brand} — ${tagline}`;
const metaDescription =
  description ||
  (currentLocale === 'ar'
    ? `${site.brand} هو مُصنّع ومُصدّر احترافي لفلاتر السيارات (هواء، مقصورة، زيت، وقود، مسّاحات، مصافي ناقل الحركة ومصابيح LED).`
    : currentLocale === 'es'
      ? `${site.brand} es un fabricante y exportador profesional de filtros automotrices (aire, habitáculo, aceite, combustible, escobillas, mallas de transmisión y luces LED).`
      : `${site.brand} is a professional automotive filter manufacturer and exporter (air, cabin, oil, fuel filters, wipers, transmission screens, LED lights).`);

const siteUrl = Astro.site?.toString() ?? 'https://hycarfilter.com';
const canonical = new URL(Astro.url.pathname, Astro.site);
const finalAlternates = alternates ?? hreflangAlternates(Astro.url.pathname, siteUrl);

// Organization JSON-LD — legal entity (E-E-A-T). `sameAs` is emitted only when a
// verifiable authority profile exists (Baidu Baike entry not found as of 2026-10-25).
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: site.entity.legalName,
  legalName: site.entity.legalName,
  alternateName: [site.brand, site.companyNameShort],
  url: siteUrl,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'CN',
    addressRegion: '河北省',
    addressLocality: '邢台市清河县',
    streetAddress: '闽江街以北、九华山路以西',
  },
  ...(site.entity.sameAs ? { sameAs: [site.entity.sameAs] } : {}),
};
---

<!doctype html>
<html lang={htmlLang} dir={htmlDir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : null}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && finalAlternates?.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
  </body>
</html>

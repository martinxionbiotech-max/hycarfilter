---
// Inquiry CTA band — reuse across pages.
import { site } from '../data/site';

interface Props {
  title?: string;
  sub?: string;
}

const { title = 'Ready to source filters?', sub = 'Tell us your model, OE number, or target market — we reply within 24 hours.' } = Astro.props;
---

<section class="cta">
  <div class="container">
    <div class="cta__panel">
      <div class="cta__copy">
        <p class="cta__eyebrow">Get a quote</p>
        <h2>{title}</h2>
        <p class="cta__sub">{sub}</p>
      </div>
      <p class="cta__actions">
        <a class="btn btn--primary" href="/contact/">Send an Inquiry</a>
        <a class="btn btn--ghost" href={site.whatsappLink} target="_blank" rel="nofollow noopener">WhatsApp Us</a>
      </p>
    </div>
  </div>
</section>

<style>
  .cta { padding: 0 var(--sp-5) var(--sp-16); }
  .cta__panel {
    position: relative;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    gap: 2rem;
    background: linear-gradient(120deg, var(--navy-900) 0%, var(--navy-800) 55%, var(--navy-700) 100%);
    border-radius: var(--radius-lg);
    padding: 3rem 3rem;
    color: #fff;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .cta__panel::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(420px 220px at 88% 0%, rgba(232, 98, 44, 0.28), transparent 65%),
      radial-gradient(360px 220px at 100% 100%, rgba(42, 95, 140, 0.5), transparent 60%);
    pointer-events: none;
  }
  .cta__copy { position: relative; }
  .cta__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--orange-400);
  }
  .cta__copy h2 { color: #fff; margin: 0 0 0.4rem; font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .cta__sub { color: var(--navy-100); margin: 0; font-size: 1.02rem; }
  .cta__actions {
    position: relative;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin: 0;
  }

  @media (max-width: 820px) {
    .cta__panel { grid-template-columns: 1fr; padding: 2rem 1.5rem; }
    .cta__actions { justify-content: flex-start; }
  }
</style>

---
import { nav, site } from '../data/site';
import { localeMeta, getLocaleFromPath, localizedHref, localizedPath, locales } from '../i18n';
import { ui } from '../i18n/ui';

const currentPath = Astro.url.pathname;
const currentLocale = getLocaleFromPath(currentPath);
const currentNative = localeMeta[currentLocale].nativeLabel;
const u = currentLocale === 'ar' || currentLocale === 'es' ? ui[currentLocale] : null;

const norm = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const cur = norm(currentPath);
const isActive = (href: string) => {
  const target = norm(localizedPath(href, currentLocale));
  if (target === '/') return cur === '/';
  return cur === target || cur.startsWith(target);
};

const navLabel = (href: string, fallback: string): string => {
  if (!u) return fallback;
  const map: Record<string, string> = {
    '/': u.nav.home,
    '/products/': u.nav.products,
    '/applications/': u.nav.applications,
    '/factory/': u.nav.factory,
    '/about/': u.nav.about,
    '/blog/': u.nav.blog,
    '/contact/': u.nav.contact,
  };
  return map[href] ?? fallback;
};
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="logo" aria-label={u ? u.logoHome : `${site.brand} — home`}>
      <span class="logo__mark">HC</span>
      <span class="logo__text">
        <strong>{site.brand}</strong>
        <small>{u ? u.logoTagline : 'filter manufacturer &amp; exporter'}</small>
      </span>
    </a>

    <div class="lang-switch">
      <details class="lang-switch__menu">
        <summary class="lang-switch__toggle" aria-label={u ? u.changeLanguage : 'Change language'}>
          <svg class="lang-switch__globe" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="1.6" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-2 2.2A15.2 15.2 0 0 1 12 4a15.2 15.2 0 0 1 2 .2M2 12h20M4.2 7h15.6M4.2 17h15.6M10 4.2A15.2 15.2 0 0 0 10 19.8A15.2 15.2 0 0 0 14 4.2 15.2 15.2 0 0 0 14 19.8" />
          </svg>
          <span class="lang-switch__current">{currentNative}</span>
          <svg class="lang-switch__chevron" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <ul class="lang-switch__list">
          {locales.map((l) => (
            <li>
              <a
                href={localizedHref(currentPath, l)}
                class={l === currentLocale ? 'lang-switch__link is-active' : 'lang-switch__link'}
                hreflang={l}
                lang={localeMeta[l].lang}
                dir={localeMeta[l].dir}
              >
                {localeMeta[l].nativeLabel}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </div>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-btn" aria-label={u ? u.toggleNav : 'Toggle navigation'}>
      <span class="nav-toggle-btn__bar"></span>
      <span class="nav-toggle-btn__bar"></span>
      <span class="nav-toggle-btn__bar"></span>
    </label>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={localizedPath(item.href, currentLocale)}
            class={isActive(item.href) ? 'nav__link is-active' : 'nav__link'}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {navLabel(item.href, item.label)}
          </a>
        ))
      }
      <a class="btn btn--primary nav__cta" href={localizedPath('/contact/', currentLocale)}>{u ? u.getQuote : 'Get a Quote'}</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--navy-800);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset;
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header-h);
  }

  .logo { display: flex; align-items: center; gap: 0.65rem; color: #fff; }
  .logo:hover { color: #fff; }
  .logo__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 9px;
    background: linear-gradient(135deg, var(--orange-500), var(--orange-600));
    color: #fff;
    font-weight: 800;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 8px rgba(232, 98, 44, 0.35);
  }
  .logo__text { display: flex; flex-direction: column; line-height: 1.12; }
  .logo__text strong { font-size: 1.12rem; letter-spacing: 0.2px; }
  .logo__text small { font-size: 0.7rem; color: var(--navy-100); }

  /* --- Language switcher --- */
  .lang-switch { margin-left: auto; position: relative; }
  .lang-switch__menu { position: relative; }
  .lang-switch__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    color: var(--navy-100);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .lang-switch__toggle::-webkit-details-marker { display: none; }
  .lang-switch__toggle:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .lang-switch__globe { flex: none; color: var(--orange-400); }
  .lang-switch__chevron { flex: none; transition: transform var(--t-fast) var(--ease); }
  .lang-switch__menu[open] .lang-switch__chevron { transform: rotate(180deg); }

  .lang-switch__list {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    min-width: 9.5rem;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: var(--shadow-lg);
    z-index: 60;
  }
  .lang-switch__link {
    display: block;
    padding: 0.5rem 0.7rem;
    border-radius: 7px;
    color: var(--brand-ink);
    font-size: 0.92rem;
    text-align: left;
  }
  .lang-switch__link:hover { background: var(--bg-soft); color: var(--brand); }
  .lang-switch__link.is-active {
    color: var(--orange-600);
    font-weight: 700;
    background: var(--orange-050);
  }
  [dir="rtl"] .lang-switch__list { right: auto; left: 0; }
  [dir="rtl"] .lang-switch__link { text-align: right; }

  .nav { display: flex; align-items: center; gap: 0.2rem; }
  .nav__link {
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    color: var(--navy-100);
    font-weight: 500;
    font-size: 0.94rem;
    transition: color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .nav__link:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .nav__link.is-active { color: var(--orange-400); font-weight: 700; }
  .nav__cta { margin-left: 0.75rem; }

  .nav-toggle { display: none; }
  .nav-toggle-btn { display: none; }

  @media (max-width: 900px) {
    .header__inner {
      flex-wrap: wrap;
      height: auto;
      min-height: var(--header-h);
      padding: 0.7rem var(--sp-5);
    }
    .nav-toggle-btn {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      cursor: pointer;
      border-radius: 8px;
    }
    .nav-toggle-btn:hover { background: rgba(255, 255, 255, 0.08); }
    .nav-toggle-btn__bar {
      display: block;
      width: 24px;
      height: 2px;
      background: #fff;
      border-radius: 2px;
      transition: transform var(--t-fast) var(--ease), opacity var(--t-fast) var(--ease);
    }
    .nav {
      display: none;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      padding: 0.5rem 0 1rem;
      gap: 0.2rem;
    }
    .nav__link { padding: 0.7rem 0.75rem; font-size: 1rem; }
    .nav__cta { margin: 0.6rem 0 0; justify-content: center; }

    .nav-toggle:checked ~ .nav { display: flex; }
    .nav-toggle:checked ~ .nav-toggle-btn .nav-toggle-btn__bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked ~ .nav-toggle-btn .nav-toggle-btn__bar:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-toggle-btn .nav-toggle-btn__bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

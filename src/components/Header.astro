---
import { nav, site } from '../data/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="logo">
      <span class="logo__mark">HC</span>
      <span class="logo__text">
        <strong>{site.brand}</strong>
        <small>filter manufacturer &amp; exporter</small>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class={isActive(item.href) ? 'nav__link is-active' : 'nav__link'}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="btn btn--primary nav__cta" href="/contact/">Get a Quote</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(6px);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 68px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--brand-ink);
  }
  .logo:hover { color: var(--brand-ink); }
  .logo__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--brand);
    color: #fff;
    font-weight: 800;
    letter-spacing: 0.5px;
  }
  .logo__text { display: flex; flex-direction: column; line-height: 1.1; }
  .logo__text strong { font-size: 1.1rem; }
  .logo__text small { font-size: 0.72rem; color: var(--ink-soft); }

  .nav { display: flex; align-items: center; gap: 0.25rem; }
  .nav__link {
    padding: 0.45rem 0.7rem;
    border-radius: 8px;
    color: var(--brand-ink);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .nav__link:hover { color: var(--brand); background: var(--bg-soft); }
  .nav__link.is-active { color: var(--brand); font-weight: 700; }
  .nav__cta { margin-left: 0.5rem; }

  @media (max-width: 820px) {
    .header__inner { flex-wrap: wrap; height: auto; padding: 0.6rem 1.25rem; }
    .nav { flex-wrap: wrap; row-gap: 0.25rem; }
    .nav__cta { margin-left: 0; }
  }
</style>

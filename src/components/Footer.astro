---
import { site, nav, complianceLinks } from '../data/site';
import { getLocaleFromPath, localizedPath } from '../i18n';
import { ui } from '../i18n/ui';

const currentLocale = getLocaleFromPath(Astro.url.pathname);
const u = currentLocale === 'ar' || currentLocale === 'es' ? ui[currentLocale] : null;

const navLabel = (href: string, fallback: string): string => {
  if (!u) return fallback;
  const map: Record<string, string> = {
    '/': u.nav.home,
    '/products/': u.nav.products,
    '/applications/': u.nav.applications,
    '/factory/': u.nav.factory,
    '/about/': u.nav.about,
    '/blog/': u.nav.blog,
    '/contact/': u.nav.contact,
  };
  return map[href] ?? fallback;
};

const legalLabel = (href: string, fallback: string): string => {
  if (!u) return fallback;
  const map: Record<string, string> = {
    '/privacy/': 'سياسة الخصوصية',
    '/terms/': 'شروط الخدمة',
    '/disclaimer/': 'إخلاء المسؤولية',
    '/cookies/': 'سياسة ملفات تعريف الارتباط',
  };
  if (currentLocale === 'es') {
    const esMap: Record<string, string> = {
      '/privacy/': 'Política de privacidad',
      '/terms/': 'Términos de servicio',
      '/disclaimer/': 'Aviso legal',
      '/cookies/': 'Política de cookies',
    };
    return esMap[href] ?? fallback;
  }
  return map[href] ?? fallback;
};

const positioning = currentLocale === 'ar' ? site.positioningAr : currentLocale === 'es' ? site.positioningEs : site.positioning;
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__col footer__col--brand">
        <p class="footer__brand">
          <span class="footer__mark">HC</span> {site.brand}
        </p>
        <p class="footer__desc">
          {positioning}
        </p>
      </div>

      <div class="footer__col">
        <h4>{u ? u.sitemap : 'Sitemap'}</h4>
        <ul class="footer__list">
          {nav.map((i) => <li><a href={localizedPath(i.href, currentLocale)}>{navLabel(i.href, i.label)}</a></li>)}
        </ul>
      </div>

      <div class="footer__col">
        <h4>{u ? u.contact : 'Contact'}</h4>
        <ul class="footer__list">
          <li>{site.address}</li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="wa-btn" href={site.whatsappLink} target="_blank" rel="nofollow noopener">💬 {u?.formWhatsappBtn ?? 'Chat on WhatsApp Now'}</a></li>
          <li><a href={`tel:${site.phone}`}>{site.phone}</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4>{u ? u.legal : 'Legal'}</h4>
        <ul class="footer__list">
          {complianceLinks.map((i) => <li><a href={localizedPath(i.href, currentLocale)}>{legalLabel(i.href, i.label)}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {new Date().getFullYear()} {site.companyName}. {u ? u.allRightsReserved : 'All rights reserved.'}</span>
      <span class="footer__since">SINCE {site.since}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy-900);
    color: #C3D0DE;
    padding: 4rem 0 1.75rem;
    margin-top: 4rem;
  }
  .footer a { color: #C3D0DE; transition: color var(--t-fast) var(--ease); }
  .footer a:hover { color: var(--orange-400); }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.2fr 1fr;
    gap: 2.5rem;
  }

  .footer__brand {
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.75rem;
  }
  .footer__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--orange-500), var(--orange-600));
    color: #fff;
    font-weight: 800;
    font-size: 0.85rem;
  }
  .footer__desc { font-size: 0.9rem; color: #9FB0C1; max-width: 34ch; }

  .footer h4 {
    color: #fff;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--orange-500);
    display: inline-block;
  }
  .footer__list { list-style: none; margin: 0; padding: 0; font-size: 0.92rem; }
  .footer__list li { margin-bottom: 0.5rem; }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.85rem;
    color: #8FA0B2;
  }
  .footer__since { letter-spacing: 0.06em; }

  @media (max-width: 820px) {
    .footer__grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
  }
  @media (max-width: 520px) {
    .footer__grid { grid-template-columns: 1fr; }
    .footer__col--brand { order: -1; }
  }
</style>

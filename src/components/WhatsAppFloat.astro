---
// Floating WhatsApp contact button — renders site-wide (bottom-right).
// Official WhatsApp green, opens a chat with the sales number from site.ts.
import { site } from '../data/site';
---

<a
  class="wa-float"
  href={site.whatsappLink}
  target="_blank"
  rel="noopener"
  aria-label="Chat with us on WhatsApp"
>
  <svg class="wa-float__icon" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
    <path
      fill="#ffffff"
      d="M16.004 3.2c-7.06 0-12.8 5.74-12.8 12.8 0 2.26.59 4.46 1.71 6.4L3.2 28.8l6.6-1.71a12.74 12.74 0 0 0 6.2 1.55c7.06 0 12.8-5.74 12.8-12.8s-5.74-12.64-12.796-12.64zm0 23.36a10.5 10.5 0 0 1-5.5-1.5l-.4-.24-3.92 1.02 1.05-3.82-.26-.41a10.5 10.5 0 0 1-1.61-5.61c0-5.82 4.74-10.56 10.56-10.56 2.82 0 5.46 1.1 7.46 3.1a10.48 10.48 0 0 1 3.1 7.46c0 5.82-4.74 10.56-10.48 10.56zm5.8-7.9c-.32-.16-1.88-.93-2.17-1.03-.29-.11-.5-.16-.71.16-.21.32-.81 1.03-1 1.24-.18.21-.37.24-.69.08-.32-.16-1.34-.49-2.55-1.57-.94-.84-1.58-1.88-1.76-2.2-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.18.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.71-1.72-.98-2.35-.26-.62-.52-.53-.71-.54h-.6c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.65 0 1.57 1.14 3.08 1.3 3.29.16.21 2.24 3.42 5.43 4.8.76.33 1.35.52 1.81.67.76.24 1.45.21 2 .13.61-.09 1.88-.77 2.14-1.51.26-.74.26-1.38.18-1.51-.08-.13-.29-.21-.61-.37z"
    />
  </svg>
  <span class="wa-float__label">Chat with us Now</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.05rem 0.65rem 0.8rem;
    border-radius: 999px;
    background: #25d366;
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
    transition: transform var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
  }
  .wa-float:hover {
    transform: translateY(-2px);
    color: #fff;
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.52);
  }
  .wa-float__icon { flex: none; }
  .wa-float__label { white-space: nowrap; }

  [dir="rtl"] .wa-float {
    right: auto;
    left: 1.25rem;
  }

  @media (max-width: 560px) {
    .wa-float__label { display: none; }
    .wa-float { padding: 0.85rem; }
  }
</style>

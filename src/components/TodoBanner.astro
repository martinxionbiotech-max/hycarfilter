---
// TODO-i18n banner — marks a page whose content is a placeholder pending
// full translation (batch B). Rendered in English regardless of locale so it
// is legible to reviewers; removed when the real translation lands.
interface Props {
  locale: string;
}

const { locale } = Astro.props;

const localeLabel: Record<string, string> = {
  ar: 'العربية (Arabic)',
  es: 'Español (Spanish)',
};
---

<div class="todo-i18n" role="note">
  <strong>TODO-i18n</strong>
  <span>
    This {localeLabel[locale] ?? locale} page is a structural placeholder.
    Content below is still English and pending translation in batch B.
  </span>
</div>

<style>
  .todo-i18n {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    margin: 1rem auto 0;
    max-width: var(--maxw);
    border: 1px dashed var(--orange-400);
    border-radius: var(--radius-sm);
    background: var(--orange-050);
    color: var(--orange-700);
    font-size: 0.88rem;
  }
  .todo-i18n strong {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.72rem;
    white-space: nowrap;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--orange-500);
    color: #fff;
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InquiryCta from '../../components/InquiryCta.astro';
import { applicationScenes } from '../../data/applicationScenes';
---

<BaseLayout
  title="Applications — Where Our Filters Work"
  description="Hycarfilter filters across four application segments: passenger cars, commercial vehicles, construction machinery and agricultural machinery — each with a full procurement guide."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>Applications</h1>
        <p class="lede">
          The same filter category behaves differently across segments. Here is how we match product to duty
          cycle — so an importer buys the right grade for the right market, not just the cheapest part number.
        </p>
      </div>

      <img class="scene-index-img" src={`${originImages.prefix}${originImages.factorySections.production[0]}`} alt="hycarfilter filter production — applications" loading="lazy" />

      <div class="grid grid--2">
        {applicationScenes.map((s) => (
          <a class="card scene-card" href={`/applications/${s.slug}/`}>
            <h3>{s.icon} {s.title} <span class="muted" style="font-size:0.7em;font-weight:600">/ {s.zh}</span></h3>
            <p class="muted">{s.lede}</p>
            <p class="small" style="margin:0.8rem 0 0.4rem"><strong>Typical filter mix:</strong></p>
            <ul class="small">
              {s.filters.slice(0, 4).map((f) => <li>{f}</li>)}
            </ul>
            <p class="small muted" style="margin:0.8rem 0 0">Read the full procurement guide &rarr;</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <InquiryCta
    title="Tell us your target segment"
    sub="We recommend the right filter grades and packaging for your market's vehicles and duty cycles."
  />
</BaseLayout>

<style>
  .scene-card { display: block; color: var(--brand-ink); }
  .scene-card:hover { color: var(--brand-ink); }
  .scene-card ul { margin: 0.3rem 0 0; padding-left: 1.1rem; color: var(--ink-soft); }
  .scene-card li { margin-bottom: 0.2rem; }
  .scene-index-img {
    width: 100%; max-width: 520px; aspect-ratio: 4 / 3; object-fit: contain;
    border: 1px solid var(--line); border-radius: 10px; background: #fff;
    padding: 0.6rem; margin: 0.5rem 0 1.5rem;
  }
</style>

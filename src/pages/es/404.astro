---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n/ui';

const u = ui.es;
---

<BaseLayout title={u.notFound}>
  <section class="section">
    <div class="container center">
      <h1>{u.notFound}</h1>
      <p class="lede">{u.notFoundText}</p>
      <p><a class="btn btn--brand" href="/es/">{u.backToHome}</a></p>
    </div>
  </section>
</BaseLayout>

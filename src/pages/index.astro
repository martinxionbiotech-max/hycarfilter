---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryCta from '../components/InquiryCta.astro';
import { site } from '../data/site';
import productsData from '../data/products.json';
import { originImages } from '../data/originImages';

const categories = productsData.categories;
const totalSkus = productsData.products.length;

const strengths = [
  { title: 'One-piece drawn steel shell', text: 'Leak-proof canister formed in a single draw — no welded seams on the pressure side.' },
  { title: '100% airtightness test', text: 'Every filter passes a full air-tightness check before packing, not batch sampling.' },
  { title: 'Hydraulic-tapped threads', text: 'Precision threads guarantee a clean, repeatable spin-on fit with zero cross-threading.' },
  { title: 'Calibrated bypass & anti-drainback', text: 'Bypass valves open at a set pressure; anti-drainback valves keep oil where it belongs on cold starts.' },
  { title: 'High/low-temp resilient seals', text: 'Sealing rings keep rebound and seal integrity from -40°C to +150°C.' },
  { title: 'Thermoset plastisol end caps', text: 'Heat-cured plastisol bonds media to end caps for a rigid, collapse-resistant core.' },
  { title: 'Composite high-temp media', text: 'Carbonized composite fiber withstands sustained heat without media collapse.' },
  { title: 'Nano-fiber filtration', text: 'Fine pores and strong dust capture lift efficiency and extend service life.' },
];
---

<BaseLayout
  title="Automotive Filter Manufacturer & Exporter"
  description="Hycarfilter is a Qinghe-based automotive filter manufacturer & exporter: air, cabin, oil, fuel filters, wipers, transmission screens and LED lights. OEM/ODM, ISO 9001 / IATF 16949."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="chip">SINCE {site.since} · Qinghe, China</p>
        <h1>Automotive Filter Manufacturer<br /><span class="hero__accent">&amp; Exporter</span></h1>
        <p class="lede">
          From air to fuel — {site.brand} guards every step of your journey. We design and export
          seven filter categories with OEM/ODM capability, built in the Qinghe filter industry cluster.
        </p>
        <p class="hero__cta">
          <a class="btn btn--primary" href="/products/">Explore Products</a>
          <a class="btn btn--ghost" href="/factory/">Inside Our Factory</a>
        </p>
        <p class="hero__stats small muted">
          <strong>7</strong> categories · <strong>{totalSkus}</strong> seed SKUs · ISO 9001 / IATF 16949
        </p>
      </div>
      <div class="hero__panel">
        <div class="hero__card">
          <img
            class="hero__img"
            src={`${originImages.prefix}${originImages.about}`}
            alt={`${site.brand} automotive filter manufacturing`}
            width="640"
            height="400"
            loading="eager"
          />
          <div class="hero__card-body">
            <strong>OEM &amp; ODM</strong>
            <p>Customize your exclusive filtration solution — from air to fuel.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CATEGORY ENTRY -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Seven Product Categories</h2>
        <p class="lede">Specializing in automotive air, cabin, oil and fuel filters, wipers, transmission filter screens and LED headlights.</p>
      </div>
      <div class="grid grid--4">
        {
          categories.map((c) => (
            <a class="card cat-card" href={`/products/${c.slug}/`}>
              <img class="cat-card__img" src={`${originImages.prefix}${originImages.categoryIcon[c.code]}`} alt={c.name_en} width="64" height="42" loading="lazy" />
              <span class="cat-card__code">{c.code.toUpperCase()}</span>
              <h3>{c.name_en}</h3>
              <p class="small muted">{c.tagline}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FACTORY STRENGTH -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>Factory Strength You Can Verify</h2>
        <p class="lede">The details that separate a reliable export filter from a cheap one — built into every {site.brand} unit.</p>
      </div>
      <div class="grid grid--2">
        {strengths.map((s) => (
          <div class="card">
            <h3>{s.title}</h3>
            <p class="muted" style="margin:0">{s.text}</p>
          </div>
        ))}
      </div>
      <p class="center mt-2">
        <a class="btn btn--brand" href="/factory/">See production lines, QC &amp; export capability &rarr;</a>
      </p>
    </div>
  </section>

  <InquiryCta />
</BaseLayout>

<style>
  .hero {
    background:
      radial-gradient(600px 360px at 85% 10%, rgba(232, 98, 44, 0.18), transparent 60%),
      linear-gradient(135deg, var(--navy-950) 0%, var(--navy-800) 55%, var(--navy-700) 100%);
    color: #fff;
    padding: 5rem 0 5.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .hero__inner { display: grid; grid-template-columns: 1.45fr 1fr; gap: 3rem; align-items: center; }
  .hero h1 { color: #fff; font-size: clamp(2rem, 4.6vw, 3.3rem); margin-bottom: 0.5rem; }
  .hero__accent { color: var(--orange-400); }
  .hero .lede { color: var(--navy-100); font-size: 1.12rem; max-width: 34ch; }
  .hero .chip { background: rgba(255,255,255,0.1); color: #fff; border-color: rgba(255,255,255,0.22); }
  .hero__cta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.75rem; }
  .hero__stats { color: var(--navy-100); margin-top: 1.75rem; }
  .hero__stats strong { color: #fff; }
  .hero__panel { display: flex; justify-content: center; }
  .hero__card {
    position: relative;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: var(--radius-lg);
    padding: 0.75rem;
    max-width: 440px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .hero__img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 9px;
  }
  .hero__card-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 0.7rem 0.6rem;
  }
  .hero__card-body strong { font-size: 1.15rem; color: #fff; }
  .hero__card-body p { color: var(--navy-100); margin: 0; font-size: 0.9rem; }

  .cat-card { display: block; color: var(--brand-ink); }
  .cat-card:hover { color: var(--brand-ink); }
  .cat-card__img {
    width: 64px; height: 42px; object-fit: contain;
    border: 1px solid var(--line); border-radius: 6px; background: #fff;
    margin-bottom: 0.6rem;
    transition: transform var(--t-med) var(--ease), border-color var(--t-med) var(--ease);
  }
  .cat-card:hover .cat-card__img { transform: scale(1.06); border-color: var(--orange-400); }
  .cat-card__code { display: inline-block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.5px; color: var(--brand); margin-bottom: 0.4rem; }
  .cat-card h3 { margin-bottom: 0.3em; }
  .cat-card p { margin: 0; }

  @media (max-width: 820px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__panel { display: none; }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { ui } from '../../i18n/ui';

const u = ui.ar;

const rfq = [
  { title: 'المنتج والموديل', text: 'فئة الفلتر، وعند التوفر، رقم OE أو موديلنا (مثل hy-af-nano).' },
  { title: 'المركبة أو المحرك المستهدف', text: 'الماركة والموديل والسنة والمحرك — أو موديل ناقل الحركة لفلاتر ناقل الحركة.' },
  { title: 'السوق المستهدف', text: 'الدولة أو المنطقة التي تبيع فيها، لنطابق الوسيط والدرجة والشهادات مع ظروفها.' },
  { title: 'الكمية والتغليف', text: 'الكمية التقديرية، والحد الأدنى للطلب، والتغليف بالعلامة الخاصة أو المحايد، وأي متطلبات للكرتون.' },
  { title: 'احتياجات الشهادات', text: 'أي موافقات لسوق الوجهة أو تقارير اختبار تحتاجها قبل الشحن.' },
];

const process = [
  { step: '1', title: 'أرسل استفسارك', text: 'أرسل النموذج، أو تواصل معنا عبر واتساب. أدرج رقم OE أو الموديل أو السوق المستهدف.' },
  { step: '2', title: 'نطابق الموديل', text: 'نؤكد الملاءمة مقابل جدول موديلاتنا والمراجع المتقاطعة، وننصح بالدرجة المناسبة لسوقك.' },
  { step: '3', title: 'العيّنة وورقة المواصفات', text: 'نوفّر ورقة مواصفات، وعند الحاجة، عيّنة ما قبل الإنتاج لموافقتك.' },
  { step: '4', title: 'عرض السعر والتأكيد', text: 'توافق على العيّنة؛ نُصدر الفاتورة الأولية ومهلة الإنتاج، ثم نشحن.' },
];
---

<BaseLayout
  title="الاتصال والاستفسار"
  description="تواصل مع hycarfilter لعروض أسعار الفلاتر: البريد الإلكتروني وواتساب والعنوان. أرسل رقم OE أو المركبة أو السوق المستهدف لعرض سعر سريع — مع إرشادات RFQ."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>اتصل بنا</h1>
        <p class="lede">أرسل الموديل أو رقم OE أو السوق المستهدف — نردّ خلال 24 ساعة.</p>
      </div>

      <div class="grid grid--2">
        <div>
          <h2>{u.getInTouch}</h2>
          <ul class="contact-list">
            <li><strong>{u.formEmailLabel}</strong><br /><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><strong>{u.formWhatsappWechatLabel}</strong><br /><a href={site.whatsappLink} target="_blank" rel="nofollow noopener">{site.whatsapp}</a></li>
            <li><strong>{u.formPhoneLabel}</strong><br /><a href={`tel:${site.phone}`}>{site.phone}</a></li>
            <li><strong>{u.formAddressLabel}</strong><br />{site.address}</li>
          </ul>
        </div>

        <div class="card">
          <h2>{u.inquiryForm}</h2>
          <p class="muted small">
            {u.inquiryFormNote}
          </p>
          <form class="form" action={`mailto:${site.email}`} method="post" enctype="text/plain">
            <label>{u.formName}<input type="text" name="name" placeholder={u.formNamePlaceholder} /></label>
            <label>{u.formCompany}<input type="text" name="company" placeholder={u.formCompanyPlaceholder} /></label>
            <label>{u.formEmail}<input type="email" name="email" placeholder={u.formEmailPlaceholder} required /></label>
            <label>{u.formWhatsapp}<input type="text" name="whatsapp" placeholder={u.formWhatsappPlaceholder} /></label>
            <label>{u.formMessage}<textarea name="message" rows="4" placeholder={u.formMessagePlaceholder} required></textarea></label>
            <button class="btn btn--primary" type="submit">{u.formSubmit}</button>
          </form>
          <p class="muted small" style="margin:0.8rem 0 0">
            {u.formDirectNote} <a href={site.whatsappLink} target="_blank" rel="nofollow noopener">WhatsApp</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>ماذا تدرج في طلب عرض السعر (RFQ)</h2>
        <p class="lede">الاستفسار الكامل يحصل على عرض سعر كامل. هذه التفاصيل الخمسة هي ما نحتاجه لمطابقة الموديل المناسب.</p>
      </div>
      <div class="grid grid--2">
        {rfq.map((r) => (
          <div class="card">
            <h3>{r.title}</h3>
            <p class="muted" style="margin:0">{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>كيف يتحول الاستفسار إلى طلب</h2>
      </div>
      <div class="grid grid--4">
        {process.map((p) => (
          <div class="card">
            <span class="chip">{p.step}</span>
            <h3 style="margin-top:0.5rem">{p.title}</h3>
            <p class="small muted" style="margin:0">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-list { list-style: none; padding: 0; margin: 0; }
  .contact-list li { margin-bottom: 1.1rem; }
  .form { display: flex; flex-direction: column; gap: 0.9rem; }
  .form label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.9rem; font-weight: 600; }
  .form input, .form textarea {
    padding: 0.6rem 0.7rem; border: 1px solid var(--line); border-radius: 8px;
    font: inherit; font-weight: 400;
  }
  .form input:focus, .form textarea:focus { outline: 2px solid var(--accent); outline-offset: 0; border-color: var(--accent); }
</style>

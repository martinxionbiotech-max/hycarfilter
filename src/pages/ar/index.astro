---
// /ar/ — Arabic homepage (full translation, batch B).
import BaseLayout from '../../layouts/BaseLayout.astro';
import InquiryCta from '../../components/InquiryCta.astro';
import { site } from '../../data/site';
import productsData from '../../data/products.json';
import { originImages } from '../../data/originImages';
import { categoryKeywords } from '../../data/categoryKeywords';
import { content } from '../../i18n/content';
import { ui } from '../../i18n/ui';

const loc = content.ar;
const u = ui.ar;
const categories = productsData.categories;
const totalSkus = productsData.products.length;

const strengths = [
  { title: 'هيكل فولاذي مسحوب قطعة واحدة', text: 'علبة مانعة للتسرب تُشكَّل بسحبة واحدة — بدون لحامات على جهة الضغط.' },
  { title: 'اختبار الإحكام الهوائي (برنامج الجودة)', text: 'يشكّل فحص الإحكام الهوائي جزءًا من برنامج مراقبة الجودة النهائي للفلاتر الدوّارة المغلقة، قبل التغليف.' },
  { title: 'سنون مُشكَّلة هيدروليكيًا', text: 'سنون دقيقة تضمن تركيبًا نظيفًا قابلًا للتكرار بدون انحراف في اللولبة.' },
  { title: 'معايرة صمام التجاوز ومنع الارتداد', text: 'تُعاير صمامات التجاوز ومنع الارتداد كجزء من برنامج الجودة؛ وضغط الفتح مرجع OE/تصميمي.' },
  { title: 'مانعات تسرب مرنة للحرارة العالية/المنخفضة', text: 'تُختار حلقات الإحكام لمقاومة الحرارة العالية/المنخفضة؛ ويعتمد النطاق الدقيق على المركّب والتطبيق.' },
  { title: 'أغطية طرفية من بلاستيسول ترموست', text: 'يلصق البلاستيسول المعالج حرارياً وسيط الترشيح بالأغطية الطرفية لقلب صلب مقاوم للانهيار.' },
  { title: 'وسيط مركّب عالي الحرارة', text: 'يُحدد الوسيط المركّب لتطبيقات الحرارة المستمرة، بما يطابق متطلب المحرك.' },
  { title: 'ترشيح بألياف نانوية', text: 'يُقدَّم وسيط الألياف النانوية ذو المسام الدقيقة للأسواق عالية الغبار، بما يطابق حمل الغبار وأهداف الكفاءة.' },
];

const faqs = [
  { q: 'ما الحد الأدنى لكميات الطلب؟', a: 'يختلف الحد الأدنى حسب الفئة — عادة 500–1,000 قطعة للفلاتر والمسّاحات، و200 قطعة لإضاءة LED. يمكن تجميع طلبات الحاويات المختلطة عبر الفئات للوصول إلى حاوية بكفاءة.' },
  { q: 'هل تدعمون OEM / ODM والعلامة الخاصة؟', a: 'نعم. نخصّص وسيط الترشيح والعلامة التجارية والتغليف والوثائق وفق سوقك، ونشحن تحت علامتك بمواصفاتك.' },
  { q: 'هل يمكنني الحصول على عيّنات وتقارير اختبار أولًا؟', a: 'نوفّر عيّنات ما قبل الإنتاج للموافقة. وحين يتطلب المشروع ذلك، يمكننا ترتيب وثائق اختبار وفق معايير مرجعية (ISO 5011 / SAE J726 للهواء وISO 4548 للزيت) لتتحقق من الأداء قبل الالتزام.' },
  { q: 'ما المهلة الزمنية للإنتاج؟', a: 'المهلة القياسية 15–25 يومًا حسب الفئة وحجم الطلب. نؤكد موعدًا محددًا عند تأكيد الطلب ونوافيك بالتحديثات خلال الإنتاج.' },
];
---

<BaseLayout
  title="مُصنّع ومُصدّر فلاتر السيارات"
  description="Hycarfilter مُصنّع ومُصدّر لفلاتر السيارات مقرّه تشينغخه: فلاتر هواء ومقصورة وزيت ووقود، مسّاحات، مصافي ناقل الحركة ومصابيح LED. OEM/ODM، إطار ISO 9001 / IATF 16949."
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="chip">منذ {site.since} · تشينغخه، الصين</p>
        <h1>مُصنّع فلاتر السيارات<br /><span class="hero__accent">ومُصدّرها</span></h1>
        <p class="lede">
          من الهواء إلى الوقود — تحرس {site.brand} كل خطوة في رحلتك. نصمّم ونصدّر
          سبع فئات من الفلاتر بقدرة OEM/ODM، من تجمّع صناعة الفلاتر في تشينغخه.
        </p>
        <p class="hero__cta">
          <a class="btn btn--primary" href="/ar/products/">استكشف المنتجات</a>
          <a class="btn btn--ghost" href="/ar/factory/">داخل مصنعنا</a>
        </p>
        <p class="hero__stats small muted">
          <strong>7</strong> فئات · <strong>{totalSkus}</strong> موديلًا أساسيًا · ISO 9001 / IATF 16949 (إطار)
        </p>
      </div>
      <div class="hero__panel">
        <div class="hero__card">
          <img
            class="hero__img"
            src="/images/company/company-main.png"
            alt={`فلاتر السيارات OEM وODM من ${site.brand}`}
            width="640"
            height="400"
            loading="eager"
          />
          <div class="hero__card-body">
            <strong>OEM &amp; ODM</strong>
            <p>خصّص حلّ الترشيح الحصري الخاص بك — من الهواء إلى الوقود.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>سبع فئات من المنتجات</h2>
        <p class="lede">متخصصون في فلاتر هواء ومقصورة وزيت ووقود السيارات، والمسّاحات، ومصافي فلاتر ناقل الحركة، والمصابيح الأمامية LED.</p>
      </div>
      <div class="grid grid--4">
        {
          categories.map((c) => (
            <a class="card cat-card" href={`/ar/products/${c.slug}/`}>
              <img class="cat-card__img" src={`${originImages.prefix}${originImages.categoryProduct[c.code]}`} alt={`مجموعة منتجات ${loc.categories[c.code].name} — ${categoryKeywords[c.code]}`} loading="lazy" />
              <span class="cat-card__code">{c.code.toUpperCase()}</span>
              <h3>{loc.categories[c.code].name}</h3>
              <p class="small muted">{loc.categories[c.code].tagline}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>قوة مصنع يمكنك التحقق منها</h2>
        <p class="lede">التفاصيل التي تفصل فلتر التصدير الموثوق عن الرخيص — مدمجة في كل وحدة من {site.brand}.</p>
      </div>
      <div class="grid grid--2">
        {strengths.map((s) => (
          <div class="card">
            <h3>{s.title}</h3>
            <p class="muted" style="margin:0">{s.text}</p>
          </div>
        ))}
      </div>
      <p class="center mt-2">
        <a class="btn btn--brand" href="/ar/factory/">شاهد خطوط الإنتاج ومراقبة الجودة وقدرة التصدير &rarr;</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>أسئلة شائعة عن المنتجات</h2>
        <p class="lede">الأسئلة التي يطرحها مشترو التصدير أكثر من غيرها — نجيب عنها مسبقًا.</p>
      </div>
      <div class="grid grid--2 mb-2">
        {faqs.map((f) => (
          <div class="card">
            <h3>{f.q}</h3>
            <p class="muted" style="margin:0">{f.a}</p>
          </div>
        ))}
      </div>
      <div class="faq-strip">
        {originImages.homeFaq.map((img, i) => (
          <img class="faq-strip__img" src={`${originImages.prefix}${img}`} alt={`أسئلة شائعة عن فلاتر السيارات من ${site.brand} — صورة ${i + 1}`} loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <InquiryCta />
</BaseLayout>

<style>
  .hero {
    background:
      radial-gradient(600px 360px at 85% 10%, rgba(232, 98, 44, 0.18), transparent 60%),
      linear-gradient(135deg, var(--navy-950) 0%, var(--navy-800) 55%, var(--navy-700) 100%);
    color: #fff;
    padding: 5rem 0 5.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .hero__inner { display: grid; grid-template-columns: 1.45fr 1fr; gap: 3rem; align-items: center; }
  .hero h1 { color: #fff; font-size: clamp(2rem, 4.6vw, 3.3rem); margin-bottom: 0.5rem; }
  .hero__accent { color: var(--orange-400); }
  .hero .lede { color: var(--navy-100); font-size: 1.12rem; max-width: 34ch; }
  .hero .chip { background: rgba(255,255,255,0.1); color: #fff; border-color: rgba(255,255,255,0.22); }
  .hero__cta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.75rem; }
  .hero__stats { color: var(--navy-100); margin-top: 1.75rem; }
  .hero__stats strong { color: #fff; }
  .hero__panel { display: flex; justify-content: center; }
  .hero__card {
    position: relative;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: var(--radius-lg);
    padding: 0.75rem;
    max-width: 440px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .hero__img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 9px; }
  .hero__card-body { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.9rem 0.7rem 0.6rem; }
  .hero__card-body strong { font-size: 1.15rem; color: #fff; }
  .hero__card-body p { color: var(--navy-100); margin: 0; font-size: 0.9rem; }

  .cat-card { display: block; color: var(--brand-ink); }
  .cat-card:hover { color: var(--brand-ink); }
  .cat-card__img {
    width: 100%; aspect-ratio: 4 / 3; object-fit: contain;
    border: 1px solid var(--line); border-radius: 8px; background: #fff;
    padding: 0.5rem; margin-bottom: 0.75rem;
    transition: transform var(--t-med) var(--ease), border-color var(--t-med) var(--ease);
  }
  .cat-card:hover .cat-card__img { transform: scale(1.06); border-color: var(--orange-400); }
  .cat-card__code { display: inline-block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.5px; color: var(--brand); margin-bottom: 0.4rem; }
  .cat-card h3 { margin-bottom: 0.3em; }
  .cat-card p { margin: 0; }

  .faq-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; }
  .faq-strip__img { width: 100%; max-height: 180px; object-fit: contain; background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 0.4rem; }

  @media (max-width: 820px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__panel { display: none; }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InquiryCta from '../../components/InquiryCta.astro';
import { site } from '../../data/site';
import { originImages } from '../../data/originImages';

const facts = [
  { k: 'التأسيس', v: 'منذ 2013' },
  { k: 'الموقع', v: 'محافظة تشينغخه، شينغتاي، خبي — تجمّع صناعة الفلاتر في الصين' },
  { k: 'النشاط', v: 'التصنيع والبحث والتطوير والمبيعات وخدمة ما بعد البيع' },
  { k: 'الفئات', v: 'هواء · مقصورة · زيت · وقود · مسّاحات · مصافي ناقل الحركة · LED' },
  { k: 'النموذج', v: 'OEM / ODM / علامة خاصة' },
  { k: 'الجودة', v: 'ISO 9001 · IATF 16949 (الإطار)' },
];

const values = [
  { title: 'الإثبات قبل الصفات', text: 'نتقدم بالتفاصيل القابلة للتحقق — هيكل مسحوب قطعة واحدة، صمام تجاوز معاير، فحص إحكام هوائي بنسبة 100% — وندعمها بعيّنات وتقارير اختبار يمكنك فحصها قبل الالتزام.' },
  { title: 'الملاءمة قبل السعر', text: 'الفلتر الذي لا يستقر أو لا يطابق المحرك هو مرتجع، أو أسوأ. نثبّت كل طلب على مرجعية أرقام OE وموافقة العيّنة قبل أن نتحدث عن التكلفة.' },
  { title: 'السوق يحدد الدرجة', text: 'سوق صحراوي وسوق معتدل يحتاجان وسائط مختلفة. نطابق المنتج مع حمل الغبار وجودة الوقود ومناخ السوق المستهدف بدلاً من شحن موديل واحد يناسب الجميع.' },
  { title: 'اتساق عبر كل صفحة', text: 'مجموعة بيانات واحدة، مجموعة حقائق واحدة. المواصفات التي تقرأها هنا هي القيمة نفسها التي نعرضها ونشحنها ونوثّقها عبر موارد منتجاتنا وبياناتنا وتقنياتنا.' },
];
---

<BaseLayout
  title="من نحن"
  description={`عن ${site.brand}: مُصنّع ومُصدّر احترافي لفلاتر السيارات منذ 2013، مقرّه تجمّع صناعة الفلاتر في تشينغخه بمقاطعة خبي، الصين — قصتنا وتمركزنا وفلسفتنا التحريرية.`}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>من نحن {site.brand}</h1>
        <p class="lede">
          {site.companyNameShort} شركة تصنيع فلاتر احترافية تدمج الإنتاج والبحث والتطوير والمبيعات
          وخدمة ما بعد البيع. نتخصص في فلاتر هواء ومقصورة وزيت ووقود السيارات، وشفرات المسّاحات،
          ومصافي فلاتر ناقل الحركة والمصابيح الأمامية LED — ونبني كل خط للتصدير.
        </p>
      </div>

      <img class="about-hero" src="/images/company/company-main.png" alt={`شركة ${site.brand} — مصنّع ومصدّر فلاتر السيارات`} loading="eager" />

      <img class="about-secondary" src={`${originImages.prefix}${originImages.aboutSecondary}`} alt={`${site.brand} في معرض أوتوميكانيكا شنغهاي`} loading="lazy" />

      <div class="grid grid--2 mb-2">
        {facts.map((f) => (
          <div class="card">
            <h3>{f.k}</h3>
            <p class="muted" style="margin:0">{f.v}</p>
          </div>
        ))}
      </div>

      <h2>قصتنا</h2>
      <p>
        يقع مقر {site.brand} في تجمّع صناعة الفلاتر بمحافظة تشينغخه في شينغتاي بمقاطعة خبي — إحدى
        أكثف قواعد إنتاج فلاتر السيارات في الصين، حيث تتوفر المواد والأدوات والوسائط وطاقة التشطيب
        ضمن نطاق توريد ضيق. ومن تلك القاعدة بنينا شركة تصمّم وتصنّع وتشحن سبع فئات من الفلاتر
        وفق نموذج OEM / ODM / العلامة الخاصة.
      </p>
      <p>
        منطق مجموعتنا هو منطق مشتري التصدير. الموزّع الذي يجمّع حاوية لا يريد شراء فلاتر الهواء من
        مصنع، وفلاتر الزيت من ثانٍ، وفلاتر المقصورة من ثالث. يريد مورّداً واحداً يفهم نظام الترشيح
        الكامل — ويستطيع التحدث بدقة عن درجة الوسيط، ومعايرة التجاوز، وارتداد مانع التسرب، وفصل الماء
        والاحتفاظ بالغبار. هذا هو الدور الذي نلعبه.
      </p>

      <h2>الكيان القانوني للشركة</h2>
      <p class="lede">
        الهوية القانونية الموثقة خلف علامة {site.brand}، مأخوذة من سجل الأعمال العام في الصين.
      </p>

      <div class="grid grid--2 mb-2">
        <div class="card"><h3>اسم الشركة</h3><p class="muted" style="margin:0">{site.entity.legalNameZh}<br />{site.entity.legalName}</p></div>
        <div class="card"><h3>التأسيس (التسجيل)</h3><p class="muted" style="margin:0">{site.entity.foundedDate}</p></div>
        <div class="card"><h3>الممثل القانوني</h3><p class="muted" style="margin:0">{site.entity.legalRepZh}</p></div>
        <div class="card"><h3>رأس المال المسجل</h3><p class="muted" style="margin:0">{site.entity.registeredCapital}</p></div>
        <div class="card"><h3>حالة التسجيل</h3><p class="muted" style="margin:0">نشطة (存续 — في التشغيل)</p></div>
        <div class="card"><h3>نطاق العمل</h3><p class="muted" style="margin:0">تصنيع قطع غيار وملحقات السيارات؛ بيع قطع غيار السيارات بالتجزئة؛ تصنيع الآلات الزراعية؛ بيع الآلات الزراعية؛ استيراد وتصدير البضائع.</p></div>
      </div>

      <p>
        الشركة مسجلة في تجمّع صناعة الفلاتر بمحافظة تشينغخه في شينغتاي بمقاطعة خبي — المنطقة المعترف بها
        على نطاق واسع كأكثف قاعدة لإنتاج فلاتر السيارات في الصين. ومن تلك القاعدة تُصمَّم مجموعة {site.brand}
        وتُصنَّع وتُشحن للتصدير.
      </p>

      <div class="entity-disclosure">
        <h3>إفصاح الكيان القانوني</h3>
        <p><strong>الكيان القانوني:</strong> {site.entity.legalName}（{site.entity.legalNameZh}）</p>
        <p><strong>العنوان المسجل:</strong> {site.entity.addressCn}</p>
        <p><strong>رمز الائتمان الاجتماعي الموحد:</strong> {site.entity.creditCode}</p>
        <p class="muted small">المصدر: سجلات الأعمال العامة في الصين، استُرجعت بتاريخ 2026-10-25. الملف الرسمي: <a href={site.entity.sameAs} target="_blank" rel="noopener">بيدو أيتشيتشا — ملف السجل التجاري（百度爱企查企业档案）</a>. لا توجد صفحة بايدو بايكه لهذا الكيان حتى تاريخ الاسترجاع.</p>
      </div>

      <h2>تمركزنا</h2>
      <p>
        نحن <strong>مُصنّع ومُصدّر للفلاتر</strong>، لسنا وسيطاً تجارياً. هذا الفارق مهم لأنه يغيّر الحوار:
        بدلاً من عرض أرخص موديل، نستطيع الحديث عن تفاصيل البناء التي تحدد الموثوقية، ونخصّص الوسيط
        والعلامة والتغليف والوثائق لسوق معيّن ومشترٍ معيّن.
      </p>
      <p>
        يثبت تمركزنا على جودة قابلة للتحقق. هيكل فولاذي مسحوب قطعة واحدة، سنون مُشكَّلة هيدروليكياً،
        صمامات تجاوز ومنع ارتداد معايرة، مانعات تسرب مرنة للحرارة العالية/المنخفضة، أغطية طرفية من
        بلاستيسول ترموست، وسيط مركّب عالي الحرارة وترشيح بألياف نانوية — هذه هي التفاصيل التي نبنيها
        في المنتج والتي يستطيع المشتري الجاد فحصها. وحيث يتعلق الأمر بالشهادات، نذكر الإطار الذي
        نعمل به ونؤكد الوضع المحدد لكل طلب ووجهة.
      </p>

      <h2>كيف نفكر في المحتوى</h2>
      <p>
        ننشر هذا الموقع كمورد لقرارات المشتريات، لا كنصوص تسويقية مُعاد تدويرها. كل مقالة وصفحة
        مواصفات مكتوبة من جهة المُصدّر في الطاولة: ما ينبغي للمشتري التحقق منه، وأين تكمن أنماط الفشل
        الحقيقية، وكيف تطابق منتجاً مع سوق بدلاً من مطاردة أدنى سعر. ستجد ملاحظاتنا التحريرية موقّعة
        حيث نتخذ موقفاً — وحيث تكون المعلومة قيمة مرجعية لا مواصفة مؤكدة، نقول ذلك صراحة.
      </p>
      <div class="grid grid--2 mt-2">
        {values.map((v) => (
          <div class="card">
            <h3>{v.title}</h3>
            <p class="muted" style="margin:0">{v.text}</p>
          </div>
        ))}
      </div>

      <p class="muted small mt-2">
        <em>
          ملاحظة: تفاصيل الشركة في هذه الصفحة محفوظة في مصدر واحد للحقيقة وتعكس المعلومات المقدمة من
          {site.companyNameShort}. تُؤكد تفاصيل الاتصال والكيان القانوني مع المالك قبل أي التزام رسمي؛
          انظر <a href="/ar/disclaimer/">إخلاء المسؤولية</a>.
        </em>
      </p>
    </div>
  </section>

  <InquiryCta title="تريد معرفة مصنعنا؟" sub="اطلب جولة في المصنع أو حزمة عيّنات أو شهادة جودة." />
</BaseLayout>

<style>
  .about-hero { width: 100%; max-height: 360px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); margin-bottom: 2rem; }
  .about-secondary { width: 100%; max-height: 300px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); margin-bottom: 2rem; }
  .entity-disclosure { background: #F4F7FA; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem 1.5rem; margin: 1.5rem 0; }
  .entity-disclosure h3 { margin-top: 0; }
  .entity-disclosure p { margin: 0.35rem 0; }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Blog"
  description="Hycarfilter blog — filter knowledge, maintenance and selection content. Coming in Phase 3."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>Blog</h1>
        <p class="lede">
          Filter knowledge, maintenance and sourcing content — consolidated into four topic clusters
          (air / oil / cabin / fuel filters) plus company news. Coming in Phase 3.
        </p>
      </div>
      <div class="card center muted">
        <p style="margin:0">Content cluster under construction. Check back soon.</p>
      </div>
    </div>
  </section>
</BaseLayout>

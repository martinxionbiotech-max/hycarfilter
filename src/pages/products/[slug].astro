---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InquiryCta from '../../components/InquiryCta.astro';
import productsData from '../../data/products.json';
import { categoryContent } from '../../data/categoryContent';
import { procurementConcerns, extraFaqs } from '../../data/procurementContent';
import { originImages } from '../../data/originImages';

const categories = productsData.categories;
const products = productsData.products;

export function getStaticPaths() {
  const catPaths = productsData.categories.map((c) => ({ params: { slug: c.slug } }));
  const skuPaths = productsData.products.map((p) => ({ params: { slug: p.model } }));
  return [...catPaths, ...skuPaths];
}

const { slug } = Astro.params;

const cat = categories.find((c) => c.slug === slug);
const sku = products.find((p) => p.model === slug);

if (!cat && !sku) {
  return Astro.redirect('/products/');
}

const v = (x: any): string => (x === null || x === undefined || x === '') ? '—' : String(x);

function dimsSummary(p: any): string {
  const d = p.dimensions;
  const parts: string[] = [];
  if (d.length_mm) parts.push(`${d.length_mm}mm`);
  if (d.width_mm) parts.push(`${d.width_mm}mm`);
  if (d.height_mm) parts.push(`H${d.height_mm}mm`);
  if (d.outer_diameter_mm) parts.push(`OD${d.outer_diameter_mm}mm`);
  if (d.thread) parts.push(d.thread);
  return parts.join(' \u00d7 ') || '—';
}

const isCategory = !!cat;

// Category-branch data
let content: any = null;
let skus: any[] = [];
let catConcerns: any[] = [];
let moreFaqs: any[] = [];
if (cat) {
  content = categoryContent[cat.code];
  skus = products.filter((p) => p.category === cat.code);
  catConcerns = procurementConcerns[cat.code] ?? [];
  moreFaqs = extraFaqs[cat.code] ?? [];
}

// SKU-branch data
let skuCat: any = null;
let skuContent: any = null;
let skuConcerns: any[] = [];
let siblings: any[] = [];
let skuGallery: string[] = [];
let lead = '';
let dims: any = null;
let hasDim = false;
let hasFitting = false;
if (sku) {
  skuCat = categories.find((c) => c.code === sku.category);
  skuContent = categoryContent[sku.category];
  skuConcerns = procurementConcerns[sku.category] ?? [];
  siblings = products.filter((p) => p.category === sku.category && p.model !== sku.model);
  skuGallery = originImages.categoryGallery[sku.category] || [];
  lead = sku.media
    ? `${sku.name_en} with ${sku.media} media${sku.target_markets.length ? ', positioned for ' + sku.target_markets.join(', ') : ''}.`
    : `${sku.name_en}, positioned for ${sku.target_markets.join(', ')}.`;
  dims = sku.dimensions;
  hasDim = !!dims.length_mm || !!dims.width_mm || !!dims.height_mm || !!dims.outer_diameter_mm || !!dims.inner_diameter_mm;
  hasFitting = !!dims.thread || !!dims.gasket;
}
---

{
  isCategory ? (
    <BaseLayout
      title={`${cat.name_en} (${cat.name_zh})`}
      description={`${cat.name_en} selection guide and SKU table from hycarfilter. ${cat.tagline}`}
    >
      <section class="section">
        <div class="container">
          <p class="small muted">
            <a href="/products/">Products</a> &rsaquo; {cat.name_en}
          </p>
          <div class="cat-head">
            <div>
              <h1>{cat.name_en} <span class="muted" style="font-size:0.6em;font-weight:600">/ {cat.name_zh}</span></h1>
              <p class="lede">{content.intro}</p>
            </div>
            <img class="cat-icon" src={`${originImages.prefix}${originImages.categoryIcon[cat.code]}`} alt={cat.name_en} width="200" height="131" loading="lazy" />
          </div>

          <h2>Selection Guide</h2>
          <div class="grid grid--2 mb-2">
            {content.selection.map((s) => (
              <div class="card">
                <h3>{s.title}</h3>
                <p class="muted" style="margin:0">{s.text}</p>
              </div>
            ))}
          </div>

          <h2>SKU Table</h2>
          <p class="muted small">
            Canonical values (defined once in <code>src/data/products.json</code>). HS code: {cat.hs_code}.
          </p>
          <div class="table-wrap">
            <table class="spec">
              <thead>
                <tr>
                  <th>Model</th>
                  <th>Series</th>
                  <th>Dimensions</th>
                  <th>Filtration Efficiency</th>
                  <th>Media</th>
                  <th>Applicable Vehicles</th>
                  <th>Carton Qty</th>
                  <th>MOQ</th>
                  <th>Details</th>
                </tr>
              </thead>
              <tbody>
                {skus.map((p) => (
                  <tr>
                    <td><strong>{p.model}</strong></td>
                    <td>{p.series}</td>
                    <td>{dimsSummary(p)}</td>
                    <td>{v(p.filtration_efficiency)}</td>
                    <td>{p.media}</td>
                    <td>{p.applicable_vehicles.join(', ')}</td>
                    <td>{p.packing.carton_qty}</td>
                    <td>{p.moq}</td>
                    <td><a href={`/products/${p.model}/`}>View &rarr;</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h2>Procurement Concerns</h2>
          <p class="muted small">What a buyer should verify before committing an order in this category.</p>
          <div class="grid grid--2">
            {catConcerns.map((c) => (
              <div class="card">
                <h3>{c.title}</h3>
                <p class="muted" style="margin:0">{c.text}</p>
              </div>
            ))}
          </div>

          <div class="opinion">
            <strong>{content.opinion.title}</strong>
            <p style="margin:0.5rem 0 0">{content.opinion.body}</p>
            <p class="byline">— hycarfilter editorial · procurement note</p>
          </div>

          <h2>Procurement Q&amp;A</h2>
          {[...content.faqs, ...moreFaqs].map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <InquiryCta
        title={`Request a ${cat.name_en} quote`}
        sub="Send your OE number, target vehicle, or market — we match the right SKU and provide a full spec sheet."
      />
    </BaseLayout>
  ) : (
    <BaseLayout
      title={`${sku.model} — ${sku.name_en}`}
      description={`${sku.model} ${sku.name_en} spec sheet: dimensions, filtration efficiency, media, materials, packing, MOQ, lead time, certifications and HS code — from hycarfilter.`}
    >
      <section class="section">
        <div class="container">
          <p class="small muted">
            <a href="/products/">Products</a> &rsaquo; <a href={`/products/${skuCat.slug}/`}>{skuCat.name_en}</a> &rsaquo; {sku.model}
          </p>
          <div class="section-head">
            <p class="chip">{sku.model} · {sku.series}</p>
            <h1>{sku.name_en} <span class="muted" style="font-size:0.6em;font-weight:600">/ {sku.name_zh}</span></h1>
            <p class="lede">{lead}</p>
          </div>

          <img
            class="sku-hero"
            src={`${originImages.prefix}${originImages.categoryProduct[sku.category]}`}
            alt={`${sku.model} — ${sku.name_en}`}
            width="320"
            height="210"
            loading="lazy"
          />

          {
            skuGallery.length > 0 ? (
              <div class="sku-gallery mb-2">
                <h2>Product Gallery</h2>
                <p class="muted small">
                  {skuCat.name_en} reference photos — {skuGallery.length} product images from the
                  {skuCat.name_en} line. The hero above is the representative shot; request specific
                  sample photos for a matched SKU.
                </p>
                <div class="sku-gallery__grid">
                  {skuGallery.map((img) => (
                    <img
                      class="sku-gallery__img"
                      src={`${originImages.prefix}${img}`}
                      alt={`${skuCat.name_en} product reference`}
                      loading="lazy"
                    />
                  ))}
                </div>
              </div>
            ) : null
          }

          <h2>Specification</h2>
          <p class="muted small">Canonical values from <code>src/data/products.json</code> — the single source of truth.</p>
          <div class="table-wrap">
            <table class="spec">
              <tbody>
                <tr><th>Model</th><td>{sku.model}</td><th>Brand</th><td>{sku.brand}</td></tr>
                <tr><th>Category</th><td><a href={`/products/${skuCat.slug}/`}>{skuCat.name_en}</a></td><th>Series</th><td>{sku.series}</td></tr>
                <tr><th>Filtration Efficiency</th><td>{v(sku.filtration_efficiency)}</td><th>Media</th><td>{sku.media}</td></tr>
                {hasDim ? (
                  <tr>
                    <th>Dimensions</th>
                    <td colspan="3">
                      {[
                        dims.length_mm ? `Length ${dims.length_mm} mm` : null,
                        dims.width_mm ? `Width ${dims.width_mm} mm` : null,
                        dims.height_mm ? `Height ${dims.height_mm} mm` : null,
                        dims.outer_diameter_mm ? `Outer Ø ${dims.outer_diameter_mm} mm` : null,
                        dims.inner_diameter_mm ? `Inner Ø ${dims.inner_diameter_mm} mm` : null,
                      ].filter(Boolean).join(' · ') || '—'}
                    </td>
                  </tr>
                ) : null}
                {hasFitting ? (
                  <tr>
                    <th>Thread / Gasket</th>
                    <td colspan="3">
                      {[dims.thread ? `Thread ${dims.thread}` : null, dims.gasket ? `Gasket ${dims.gasket}` : null].filter(Boolean).join(' · ')}
                    </td>
                  </tr>
                ) : null}
                <tr><th>Housing</th><td>{v(sku.materials.housing)}</td><th>Media Material</th><td>{v(sku.materials.media_material)}</td></tr>
                <tr><th>End Cap</th><td>{v(sku.materials.endcap)}</td><th>Seal</th><td>{v(sku.materials.seal)}</td></tr>
                <tr><th>Applicable Vehicles</th><td colspan="3">{sku.applicable_vehicles.join(', ')}</td></tr>
                <tr><th>OE Numbers</th><td colspan="3">{sku.oe_numbers.join(', ')}</td></tr>
                <tr><th>Cross Reference</th><td colspan="3">{sku.cross_reference.join(', ')}</td></tr>
                <tr><th>Inner Box</th><td>{sku.packing.inner_box}</td><th>Outer Carton</th><td>{sku.packing.outer_carton}</td></tr>
                <tr><th>Carton Qty</th><td>{sku.packing.carton_qty} pcs</td><th>Net Weight</th><td>{sku.packing.net_weight_kg} kg/unit</td></tr>
                <tr><th>MOQ</th><td>{sku.moq} pcs</td><th>Lead Time</th><td>{sku.lead_time_days} days</td></tr>
                <tr><th>Certifications</th><td>{sku.certifications.join(', ')}</td><th>HS Code</th><td>{sku.hs_code}</td></tr>
                <tr><th>Target Markets</th><td colspan="3">{sku.target_markets.join(', ')}</td></tr>
              </tbody>
            </table>
          </div>

          <h2>Procurement Concerns for This Category</h2>
          <p class="muted small">The real worries a {skuCat.name_en.toLowerCase()} buyer raises — and how we address them.</p>
          <div class="grid grid--2">
            {skuConcerns.map((c) => (
              <div class="card">
                <h3>{c.title}</h3>
                <p class="muted" style="margin:0">{c.text}</p>
              </div>
            ))}
          </div>

          <h2>Selection Guide</h2>
          <div class="grid grid--2 mb-2">
            {skuContent.selection.map((s) => (
              <div class="card">
                <h3>{s.title}</h3>
                <p class="muted" style="margin:0">{s.text}</p>
              </div>
            ))}
          </div>

          <div class="opinion">
            <strong>{skuContent.opinion.title}</strong>
            <p style="margin:0.5rem 0 0">{skuContent.opinion.body}</p>
            <p class="byline">— hycarfilter editorial · procurement note</p>
          </div>

          {siblings.length > 0 ? (
            <div class="mt-2">
              <h2>Related {skuCat.name_en} SKUs</h2>
              <div class="grid grid--3">
                {siblings.map((s) => (
                  <a class="card sku-card" href={`/products/${s.model}/`}>
                    <span class="chip">{s.model}</span>
                    <h3 style="margin:0.5rem 0 0.2rem">{s.series}</h3>
                    <p class="small muted" style="margin:0">{s.name_en}</p>
                  </a>
                ))}
              </div>
            </div>
          ) : null}
        </div>
      </section>

      <InquiryCta
        title={`Request a ${sku.model} quote`}
        sub={`Send us your OE number or target vehicle — we confirm fitment for ${sku.model} and provide the full spec sheet.`}
      />
    </BaseLayout>
  )
}

<style>
  code { background: var(--bg-soft); padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.85em; }
  .cat-head { display: grid; grid-template-columns: 1.5fr 1fr; gap: 2rem; align-items: center; margin-bottom: 2rem; }
  .cat-icon { width: 200px; height: 131px; object-fit: contain; justify-self: end; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .sku-hero { width: 320px; height: 210px; object-fit: contain; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; margin-bottom: 2rem; }
  .sku-gallery__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 0.6rem; }
  .sku-gallery__img { width: 100%; aspect-ratio: 1 / 1; object-fit: contain; background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 0.3rem; }
  .sku-card { display: block; color: var(--brand-ink); }
  .sku-card:hover { color: var(--brand-ink); }
  @media (max-width: 820px) {
    .cat-head { grid-template-columns: 1fr; }
    .cat-icon { justify-self: start; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryCta from '../components/InquiryCta.astro';
import { site } from '../data/site';
import { originImages } from '../data/originImages';

const facts = [
  { k: 'Brand lineage', v: 'Since 2013' },
  { k: 'Legal entity', v: 'Registered 2023-11-28' },
  { k: 'Location', v: 'Qinghe County, Xingtai, Hebei — China filter industry cluster' },
  { k: 'Business', v: 'Manufacturing, R&D, sales & after-sales service' },
  { k: 'Categories', v: 'Air · Cabin · Oil · Fuel filters · Wipers · Transmission screens · LED' },
  { k: 'Model', v: 'OEM / ODM / private label' },
  { k: 'Quality', v: 'ISO 9001 · IATF 16949 (framework)' },
];

const values = [
  { title: 'Proof over adjectives', text: 'We lead with verifiable details — a one-piece drawn shell, a calibrated bypass valve, an airtightness check as part of our QC program — and back them with samples and documentation you can inspect before you commit.' },
  { title: 'Fitment before price', text: 'A filter that does not seat or does not match the engine is a return, or worse. We anchor every order on OE cross-referencing and sample approval before we talk about cost.' },
  { title: 'The market decides the grade', text: 'A desert market and a temperate market need different media. We match product to the target market\u2019s dust load, fuel quality and climate rather than shipping a one-size-fits-all SKU.' },
  { title: 'Consistency across every page', text: 'One dataset, one set of facts. The specification you read here is the same value we quote, ship and document across our product, data and technical resources.' },
];
---

<BaseLayout
  title="About Us"
  description={`About ${site.brand}: the hycarfilter brand and its manufacturing team trace their business to 2013, while the legal entity Qinghe County Hongying Auto Parts Co., Ltd. was registered on 2023-11-28 — our story, positioning and editorial philosophy.`}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>About {site.brand}</h1>
        <p class="lede">
          {site.companyNameShort} is a professional filter manufacturing company integrating production,
          research and development, sales and after-sales service. We specialize in automotive air filters,
          cabin filters, oil filters, fuel filters, wiper blades, transmission filter screens and LED headlights —
          and we build every line for export.
        </p>
      </div>

      <img class="about-hero" src="/images/company/company-main.png" alt={`${site.brand} company — automotive filter manufacturer & exporter`} loading="eager" />

      <img class="about-secondary" src={`${originImages.prefix}${originImages.aboutSecondary}`} alt={`${site.brand} at Automechanika Shanghai exhibition`} loading="lazy" />

      <div class="grid grid--2 mb-2">
        {facts.map((f) => (
          <div class="card">
            <h3>{f.k}</h3>
            <p class="muted" style="margin:0">{f.v}</p>
          </div>
        ))}
      </div>

      <h2>Our story</h2>
      <p>
        {site.brand} is headquartered in the Qinghe County filter industry cluster of Xingtai, Hebei — one of
        China&rsquo;s densest automotive-filter production bases, where materials, tooling, media and finishing
        capacity sit within a tight supply radius. From that base we have built a company that designs,
        manufactures and ships seven filter categories under an OEM / ODM / private-label model.
      </p>
      <p>
        The logic of our range is the logic of the export buyer. A distributor consolidating a container does not
        want to buy air filters from one factory, oil filters from a second and cabin filters from a third. They
        want one supplier who understands the full filtration system — and who can speak precisely about media
        grade, bypass calibration, seal rebound, water separation and dust-holding. That is the role we play.
      </p>

      <h2>Brand lineage &amp; legal entity</h2>
      <p>
        Two facts are disclosed side by side so the record is unambiguous. The {site.brand} brand and its
        manufacturing team trace their business back to {site.brandHistory.brandFounded}. The current legal
        entity, {site.entity.legalName}（{site.entity.legalNameZh}）, was registered on{' '}
        {site.brandHistory.entityFounded}. When this site says &ldquo;since {site.since}&rdquo;, it refers to the
        brand and team lineage, not the registration date of the legal entity.
      </p>

      <h2>Company entity</h2>
      <p class="lede">
        The verified legal identity behind the {site.brand} brand, sourced from China&rsquo;s public business
        registry.
      </p>

      <div class="grid grid--2 mb-2">
        <div class="card"><h3>Company name</h3><p class="muted" style="margin:0">{site.entity.legalNameZh}<br />{site.entity.legalName}</p></div>
        <div class="card"><h3>Founded (registered)</h3><p class="muted" style="margin:0">{site.entity.foundedDate}</p></div>
        <div class="card"><h3>Legal representative</h3><p class="muted" style="margin:0">{site.entity.legalRepZh}</p></div>
        <div class="card"><h3>Registered capital</h3><p class="muted" style="margin:0">{site.entity.registeredCapital}</p></div>
        <div class="card"><h3>Registration status</h3><p class="muted" style="margin:0">Active (存续 — in operation)</p></div>
        <div class="card"><h3>Business scope</h3><p class="muted" style="margin:0">Manufacture of automotive parts &amp; accessories; wholesale of automotive parts; retail of automotive parts.</p></div>
      </div>

      <p>
        The company is registered in the Qinghe County filter industry cluster of Xingtai, Hebei — the region
        widely recognised as China&rsquo;s densest base for automotive-filter production. That is the base from
        which the {site.brand} range is designed, manufactured and shipped for export.
      </p>

      <div class="entity-disclosure">
        <h3>Legal entity disclosure</h3>
        <p><strong>Legal entity:</strong> {site.entity.legalName}（{site.entity.legalNameZh}）</p>
        <p><strong>Registered address:</strong> {site.entity.addressCn}</p>
        <p><strong>Unified Social Credit Code:</strong> {site.entity.creditCode}</p>
        <p class="muted small">Source: Baidu Aiqicha official registry profile（爱企查企业档案）, retrieved 2026-10-25. Official registry profile: <a href={site.entity.sameAs} target="_blank" rel="noopener">Baidu Aiqicha — business registry profile（百度爱企查企业档案）</a>.</p>
      </div>

      <h2>Our positioning</h2>
      <p>
        We are a <strong>filter manufacturer and exporter</strong>, not a trading pass-through. That distinction
        matters because it changes the conversation: instead of quoting the cheapest SKU, we can talk about the
        construction details that decide reliability, and we can customize media, branding, packaging and
        documentation to a specific market and a specific buyer.
      </p>
      <p>
        Our positioning is anchored on verifiable quality. A one-piece drawn steel shell, hydraulic-tapped
        threads, calibrated bypass and anti-drainback valves, high/low-temperature-resilient seals, thermoset
        plastisol end caps, composite high-temperature media and nano-fiber filtration — these are the details we
        build into the product and the details a serious buyer can check. Where certification is involved, we state
        the framework we operate to and confirm specific status per order and destination.
      </p>
      <p>
        On production: in-house manufacturing is our core model — media pleating, end-cap bonding, spin-on assembly
        and final inspection run on our own lines. For select product categories we may also work with collaborating
        factories, and where that applies the specific production source is confirmed per order rather than assumed.
      </p>

      <h2>How we think about content</h2>
      <p>
        We publish this website as a resource for procurement decisions, not as recycled marketing copy. Every
        article and specification page is written from the exporter&rsquo;s side of the table: what a buyer should
        verify, where the real failure modes are, and how to match a product to a market instead of chasing the
        lowest price. You will find our editorial notes signed where we take a position — and where a fact is a
        reference value rather than a confirmed specification, we say so.
      </p>
      <div class="grid grid--2 mt-2">
        {values.map((v) => (
          <div class="card">
            <h3>{v.title}</h3>
            <p class="muted" style="margin:0">{v.text}</p>
          </div>
        ))}
      </div>

      <p class="muted small mt-2">
        <em>
          Note: company details on this page are maintained in a single source of truth and reflect the
          information provided by {site.companyNameShort}. Contact and legal-entity details are confirmed with
          the owner before any formal commitment; see our <a href="/disclaimer/">Disclaimer</a>.
        </em>
      </p>
    </div>
  </section>

  <InquiryCta title="Want to know our factory?" sub="Ask for a factory tour, sample pack, or quality certificate." />
</BaseLayout>

<style>
  .about-hero { width: 100%; max-height: 360px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); margin-bottom: 2rem; }
  .about-secondary { width: 100%; max-height: 300px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); margin-bottom: 2rem; }
  .entity-disclosure { background: #F4F7FA; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem 1.5rem; margin: 1.5rem 0; }
  .entity-disclosure h3 { margin-top: 0; }
  .entity-disclosure p { margin: 0.35rem 0; }
</style>

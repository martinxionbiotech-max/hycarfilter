---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryCta from '../components/InquiryCta.astro';
import { site } from '../data/site';
import { originImages } from '../data/originImages';

const processes = [
  { title: 'Filter media & pleating', text: 'Cellulose, composite, nano-fiber and activated-carbon media are selected by application, then pleated to controlled density. Pleat count and media area directly set dust-holding capacity and service life.' },
  { title: 'End-cap bonding & curing', text: 'Media is bonded to end caps with thermoset plastisol or PU and heat-cured for a rigid, collapse-resistant core that holds its shape under sustained pressure and heat.' },
  { title: 'Spin-on assembly', text: 'Oil and fuel spin-on filters are assembled on dedicated lines with one-piece drawn steel shells, calibrated bypass valves and anti-drainback valves, then sealed and tested.' },
  { title: 'Panel & element lines', text: 'Air, cabin and panel elements are cut, pleated, framed and sealed to dimensional tolerance — the detail that decides whether an element seats cleanly and seals without bypass.' },
];

const qc = [
  { title: 'Incoming inspection (IQC)', text: 'Raw media, steel, rubber, plastisol and hardware are checked against spec before entering production, so a bad batch is caught before it becomes a bad filter.' },
  { title: 'In-process inspection (IPQC)', text: 'Critical parameters — pleat integrity, bond strength, thread quality, valve calibration — are verified at line stations during assembly.' },
  { title: 'Final inspection & airtightness', text: 'Every completed filter passes a full air-tightness check, and finished goods are sampled to AQL before packing. This is full-coverage verification, not batch sampling.' },
  { title: 'Export inspection (OQC)', text: 'Pre-shipment checks cover packaging, labelling, carton strength, pallet cube and documentation, so the product arrives as specified.' },
];

const logistics = [
  { title: 'Sealed, humidity-controlled packing', text: 'Elements are sealed in polybags with desiccant; steel canisters are protected with an internal oil film and VCI paper. Carbon media is sealed away from solvents and moisture to prevent pre-saturation.' },
  { title: 'Export-grade cartons & pallets', text: 'Double-wall and 5-ply cartons with corner reinforcement and dividers protect light panels, dentable canisters and long blades through container stacking and sea freight.' },
  { title: 'Consolidated & mixed loading', text: 'Multi-SKU and mixed-container orders are consolidated per category and destination, with carton quantity and cube optimised to keep freight cost per unit low.' },
];

const certFramework = [
  { title: 'Quality management — ISO 9001', text: 'We operate to an ISO 9001 quality-management framework covering production, inspection and after-sales service.' },
  { title: 'Automotive — IATF 16949 (framework)', text: 'We align our automotive quality practices to the IATF 16949 framework for OEM / ODM programmes; specific certification status is confirmed per order and market.' },
  { title: 'Product compliance — CE / RoHS', text: 'LED products carry CE and RoHS documentation as a baseline; destination-market approvals are confirmed before shipment where required.' },
  { title: 'Test standards — ISO / SAE', text: 'Performance claims are verified against relevant standards such as ISO 5011 / SAE J726 (air) and ISO 4548 (oil), with test reports available for OEM projects.' },
];

const aiNote = 'Illustrative rendering — not company photography · 示意图，非公司实拍 · رسم توضيحي — ليس تصويراً للشركة';
const licenseCaption = [
  'Business license — Qinghe County Hongying Auto Parts Co., Ltd.',
  '营业执照 — 清河县宏盈汽车零部件有限公司',
  'رخصة تجارية — شركة تشينغخه هونغ ينغ لقطع غيار السيارات المحدودة',
];
---

<BaseLayout
  title="Our Factory — Production, Quality & Export Capability"
  description={`Inside the ${site.brand} factory: production lines, quality control, export packaging and the certification framework behind our automotive filters. Based in the Qinghe filter industry cluster.`}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>Our Factory</h1>
        <p class="lede">
          {site.companyNameShort} is based in the Qinghe County filter industry cluster of Xingtai, Hebei —
          one of China&rsquo;s densest automotive-filter production bases. We run integrated production,
          research and development, quality control and export logistics for seven filter categories.
        </p>
      </div>

      <div class="factory-gallery grid grid--2 mb-2">
        {originImages.factory.map((img, i) => (
          <img class="factory-photo" src={`${originImages.prefix}${img}`} alt={`${site.brand} factory & production — photo ${i + 1}`} loading="lazy" />
        ))}
      </div>

      <div class="grid grid--2 mb-2">
        <div class="card"><h3>Founded</h3><p class="muted" style="margin:0">SINCE {site.since}</p></div>
        <div class="card"><h3>Location</h3><p class="muted" style="margin:0">{site.address}</p></div>
        <div class="card"><h3>Business model</h3><p class="muted" style="margin:0">OEM / ODM / private label</p></div>
        <div class="card"><h3>Categories</h3><p class="muted" style="margin:0">Air · Cabin · Oil · Fuel filters · Wipers · Transmission screens · LED</p></div>
      </div>

      <div class="entity-disclosure">
        <h3>Legal entity disclosure</h3>
        <p><strong>Legal entity:</strong> {site.entity.legalName}（{site.entity.legalNameZh}）</p>
        <p><strong>Registered address:</strong> {site.entity.addressCn}</p>
        <p><strong>Unified Social Credit Code:</strong> {site.entity.creditCode}</p>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>Production Lines</h2>
        <p class="lede">Seven categories, produced on dedicated lines with the processes that decide filter quality.</p>
      </div>
      <div class="grid grid--2">
        {processes.map((p) => (
          <div class="card">
            <h3>{p.title}</h3>
            <p class="muted" style="margin:0">{p.text}</p>
          </div>
        ))}
      </div>
      <div class="factory-strip mt-2">
        {originImages.factorySections.production.map((img, i) => (
          <img class="factory-strip__img" src={`${originImages.prefix}${img}`} alt={`${site.brand} filter production line — photo ${i + 1}`} loading="lazy" />
        ))}
      </div>
      <div class="ai-illustrations mt-2">
        <p class="ai-note">{aiNote}</p>
        {originImages.aiIllustrations.production.map((img, i) => (
          <img class="ai-illustration__img" src={`${originImages.aiIllustrations.prefix}${img}`} alt={`${site.brand} production line — illustrative rendering ${i + 1}`} loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Quality Control</h2>
        <p class="lede">A four-stage inspection chain, from raw material to the packed carton.</p>
      </div>
      <div class="grid grid--2">
        {qc.map((q) => (
          <div class="card">
            <h3>{q.title}</h3>
            <p class="muted" style="margin:0">{q.text}</p>
          </div>
        ))}
      </div>
      <div class="factory-strip mt-2">
        {originImages.factorySections.qc.map((img, i) => (
          <img class="factory-strip__img" src={`${originImages.prefix}${img}`} alt={`${site.brand} quality control — inspection ${i + 1}`} loading="lazy" />
        ))}
      </div>
      <div class="ai-illustrations mt-2">
        <p class="ai-note">{aiNote}</p>
        {originImages.aiIllustrations.qc.map((img, i) => (
          <img class="ai-illustration__img" src={`${originImages.aiIllustrations.prefix}${img}`} alt={`${site.brand} quality control — illustrative rendering ${i + 1}`} loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>Warehousing &amp; Export Packing</h2>
        <p class="lede">Protecting the product from our floor to the destination warehouse.</p>
      </div>
      <div class="grid grid--3">
        {logistics.map((l) => (
          <div class="card">
            <h3>{l.title}</h3>
            <p class="muted" style="margin:0">{l.text}</p>
          </div>
        ))}
      </div>
      <div class="factory-strip mt-2">
        {originImages.factorySections.warehouse.map((img, i) => (
          <img class="factory-strip__img" src={`${originImages.prefix}${img}`} alt={`${site.brand} export packing & warehousing — photo ${i + 1}`} loading="lazy" />
        ))}
      </div>
      <div class="ai-illustrations mt-2">
        <p class="ai-note">{aiNote}</p>
        {originImages.aiIllustrations.warehouse.map((img, i) => (
          <img class="ai-illustration__img" src={`${originImages.aiIllustrations.prefix}${img}`} alt={`${site.brand} warehousing — illustrative rendering ${i + 1}`} loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Certification Framework</h2>
        <p class="lede">
          The standards we build to. Specific certification status and test reports are confirmed per order and
          destination market.
        </p>
      </div>
      <div class="grid grid--2">
        {certFramework.map((c) => (
          <div class="card">
            <h3>{c.title}</h3>
            <p class="muted" style="margin:0">{c.text}</p>
          </div>
        ))}
      </div>

      <div class="business-license mt-2">
        <h3>Business License</h3>
        <p class="muted" style="margin:0 0 0.75rem">
          {licenseCaption[0]}<br/>
          {licenseCaption[1]}<br/>
          {licenseCaption[2]}
        </p>
        <img class="business-license__img" src={`${originImages.prefix}${originImages.businessLicense}`} alt="Business license — Qinghe County Hongying Auto Parts Co., Ltd." loading="lazy" />
      </div>

      <img class="cert-banner mt-2" src={`${originImages.prefix}${originImages.qualification.banner}`} alt={`${site.brand} qualification & certification banner`} loading="lazy" />
      <div class="cert-grid mt-2">
        {originImages.qualification.docs.map((img, i) => (
          <img class="cert-grid__img" src={`${originImages.prefix}${img}`} alt={`${site.brand} certification — ${i + 1}`} loading="lazy" />
        ))}
      </div>

      <div class="opinion">
        <strong>What we verify, not just what we claim</strong>
        <p style="margin:0.5rem 0 0">
          A filter factory earns trust through proof, not adjectives. That is why our positioning leads with
          verifiable details — a one-piece drawn shell, a calibrated bypass valve, a 100% airtightness check —
          and with test reports and samples you can inspect before you commit. We would rather show you the
          construction than ask you to take a claim on faith.
        </p>
        <p class="byline">— {site.brand} editorial · factory note</p>
      </div>
    </div>
  </section>

  <InquiryCta
    title="Want to see the factory?"
    sub="Ask for a factory tour, a sample pack, or the quality certificates and test reports for your category."
  />
</BaseLayout>

<style>
  .factory-photo { width: 100%; height: 240px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); }
  .factory-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; }
  .factory-strip__img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; border: 1px solid var(--line); background: #fff; }
  .cert-banner { width: 100%; height: auto; max-height: 220px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); }
  .cert-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
  .cert-grid__img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; border: 1px solid var(--line); background: #fff; }
  .entity-disclosure { background: #F4F7FA; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem 1.5rem; margin: 1.5rem 0; }
  .entity-disclosure h3 { margin-top: 0; }
  .entity-disclosure p { margin: 0.35rem 0; }
  .ai-illustrations { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.75rem; }
  .ai-illustration__img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; border: 1px dashed var(--line-strong); background: #fafafa; }
  .ai-note { font-size: 0.82rem; color: var(--ink-soft); margin: 0 0 0.5rem; }
  .business-license { background: #F4F7FA; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem 1.5rem; margin: 1.5rem 0 1rem; }
  .business-license h3 { margin-top: 0; }
  .business-license__img { width: 100%; max-width: 560px; height: auto; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
</style>
